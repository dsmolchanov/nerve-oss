# Copy to .env and replace each empty value with: openssl rand -hex 32
# Keep .env private (chmod 600). Hex avoids URI escaping in POSTGRES_PASSWORD.
NERVE_API_KEY=
POSTGRES_PASSWORD=
STALWART_PASSWORD=

# Host ports; listeners always publish to 127.0.0.1.
NERVE_HTTP_PORT=8088
NERVE_VIEWER_PORT=8025
NERVE_SMTP_PORT=2525
NERVE_INBOUND_PORT=2526
NERVE_JMAP_PORT=8080
NERVE_SUBMISSION_PORT=1587
NERVE_IMAPS_PORT=1993

# Optional: COMPOSE_PROFILES=full starts local Stalwart SMTP/JMAP.
# COMPOSE_PROFILES=full
# vector only starts Qdrant; it does not implement an embedding provider.
NERVE_EMBED_PROVIDER=noop
